<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：GUI 子系统，双击不出现任何控制台黑框。
         命令行仍可用（从 cmd/PowerShell 调用时手动 AttachConsole 接回输出）。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PCL2VanillaRestore</AssemblyName>
    <RootNamespace>PCL2VanillaRestore</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 沿用 PCL2 本体图标（从其 .rsrc 逐字节重建的 13 帧 .ico），
         方便不熟悉命令行的用户在文件夹里一眼认出该双击哪个 -->
    <ApplicationIcon>assets\pcl2.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 版本 5 段 a.b.c.d.e：前 4 段 = 最新适配的 PCL2 版本，第 5 段 = 工具修订号。
         NuGet 的 Version 只认 4 段，所以 Version 用 4 段语义值；
         用户可见版本走 InformationalVersion（5 段），FileVersion 可为 4 段。 -->
    <Version>2.99.0.1</Version>
    <AssemblyVersion>2.99.0.0</AssemblyVersion>
    <FileVersion>2.99.0.1</FileVersion>
    <InformationalVersion>2.99.0.1.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Authors>NekoYume517</Authors>
    <Product>PCL2 Vanilla Download Restore Tool</Product>
    <Description>Restore the "Download → Vanilla Game" and "Import Modpack" entry points in Plain Craft Launcher 2 (PCL2) 2.99.</Description>
    <Copyright>Copyright (c) 2026 NekoYume517</Copyright>
    <RepositoryUrl>https://github.com/NekoYume517/PCL2-Download-Tool</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- 已验证适配的 PCL 版本集合（分号分隔），工具启动时读出来做版本对齐 -->
    <AssemblyMetadata Include="SupportedPclVersions" Value="2.99.0.0;2.99.0.1" />
  </ItemGroup>
</Project>
